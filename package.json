{
  "name": "pulselens",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/types",
    "packages/capture",
    "packages/explain",
    "packages/ui",
    "apps/lab",
    "apps/demo"
  ],
  "scripts": {
