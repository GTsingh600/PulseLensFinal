# Copy to .env and fill in. .env is gitignored; never commit real values.

# Signs just-in-time pulses: HMAC_SHA256(secret, pulse_id|kind|params|session_id). Use 32+ random bytes, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
PULSE_HMAC_SECRET=change-me

# Passcode the presenter types to use agent actions (X-Console-Passcode header). Prototype-level only.
CONSOLE_PASSCODE=change-me

# Comma-separated person codes of the team. purge_volunteers.py keeps only these after the event.
TEAM_CODES=P01,P02,P03
